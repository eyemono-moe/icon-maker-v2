{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["vinxi/types/client"],
    "isolatedModules": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "skipLibCheck": true
  },
  "exclude": [
    "reproductions/solid-2-ark-ui/src.tsx",
    "reproductions/solid-2-ark-ui/src-router-meta.tsx",
    "reproductions/solid-2-ark-ui/vite.config.ts"
  ]
}
